{application, emqx_offline_message_plugin, [
    {description, "EMQX Offline Message Plugin"},
    %% Do not update version manually, use make bump-version-patch/minor/major instead
    {vsn, "2.0.2"},
    {modules, []},
    {registered, [emqx_omp_sup]},
    {applications, [kernel, stdlib, emqx_resource]},
    %% emqx_resource is provided by EMQX, not bundled in the plugin package.
    {optional_applications, [emqx_resource]},
    {mod, {emqx_offline_message_plugin_app, []}},
    {env, []},
    {licenses, ["Private"]},
    {maintainers, ["EMQX <emqx@emqx.io>"]}
]}.
